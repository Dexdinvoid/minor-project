# Copy to .env (git-ignored). Never commit real keys.
# ---- Chain ----
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Batcher wallet (pays gas for anchor()). Local dev: paste a Hardhat node account key printed by `hardhat node`.
BATCHER_PRIVATE_KEY=
# Dev faucet (local only). Leave false on Sepolia.
DEV_FAUCET=true
DEV_FAUCET_AMOUNT_ETH=1
# Filled by `pnpm --filter @sc/contracts deploy:local` / deploy:sepolia
KEY_REGISTRY_ADDRESS=
ANCHOR_REGISTRY_ADDRESS=
# ---- Relay ----
RELAY_PORT=4000
RELAY_DB_PATH=./data/relay.db
KUBO_RPC_URL=http://127.0.0.1:5001
CLIENT_ORIGIN=http://localhost:5173
# ---- Batcher ----
BATCHER_PORT=4100
BATCHER_DB_PATH=./data/batcher.db
RELAY_URL=http://127.0.0.1:4000
BATCH_MAX_LEAVES=64
BATCH_MAX_AGE_MS=60000
# ---- Sepolia only ----
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
KUBO_IMAGE=
